# Copy to .env (git-ignored). Local-development values only; never reuse them anywhere shared.
POSTGRES_PASSWORD=localdev_only_change_me
ASSET_DB_PASSWORD=asset_localdev
WALLET_DB_PASSWORD=wallet_localdev
SWAP_DB_PASSWORD=swap_localdev
TXN_DB_PASSWORD=txn_localdev
RABBITMQ_USER=opencrypto
RABBITMQ_PASSWORD=localdev_only_change_me
GRAFANA_USER=admin
GRAFANA_PASSWORD=localdev_only_change_me

# Market data: "coingecko" (real prices, needs internet) or "simulated" (offline, reproducible)
MARKET_PROVIDER=coingecko
# Optional free CoinGecko demo key (raises the public rate limit)
COINGECKO_API_KEY=
# Simulated provider only: a number makes the price path reproducible
MARKET_SEED=

# Gateway rate limits (token bucket per user/IP)
RATELIMIT_READ_RATE=30
RATELIMIT_READ_BURST=60
RATELIMIT_WRITE_RATE=5
RATELIMIT_WRITE_BURST=10

# AI phase: copilot engine and LLM settings (bound to copilot.llm.* / LlmSettings)
COPILOT_ENGINE=deterministic
# Reasoning model. LLM_PROVIDER=anthropic plus an API key makes a Claude ChatModel available to engines.
LLM_PROVIDER=
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
# Local model (Ollama) for steps that see personal data. Empty model = not configured.
# Docker infra exposes Ollama on 11435 (a native install uses 11434: set LOCAL_LLM_BASE_URL).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:1.5b
